# Copy to .env and fill in. Never commit .env.
# Variable names only; the foundation step will add the names the task requires.

# System A (test environment)
SYSTEM_A_BASE_URL=https://example.invalid/api
SYSTEM_A_API_KEY=replace-me

# System B (test environment)
SYSTEM_B_BASE_URL=https://example.invalid/api
SYSTEM_B_API_KEY=replace-me

# Safety: writes to a target system stay off unless set to false
DRY_RUN=true
