# Copy to .env and fill in. Never commit .env.
# Variable names only; the foundation step will add the names the task requires.

# HubSpot (test environment)
HUBSPOT_BASE_URL=https://example.invalid/api
HUBSPOT_APP_TOKEN=replace-me
HUBSPOT_WEBHOOKS_SECRET=replace-me
# Not a secret. The original webhook address, used only as part of the signed text.
# Never call this address.
HUBSPOT_WEBHOOK_URI=https://integrasjon.fjordforum.no/webhooks/hubspot

# PowerOffice (test environment)
POWEROFFICE_BASE_URL=https://example.invalid/api
POWEROFFICE_CLIENT_ID=replace-me
POWEROFFICE_CLIENT_SECRET=replace-me

# Safety: writes to a target system stay off unless set to false
DRY_RUN=true
